<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_title" android:textColor="@color/notification_text" android:textSize="16sp"/>
    <LinearLayout style="?android:attr/buttonBarStyle" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reminder_start"/>
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/snooze10" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reminder_snooze_10"/>
    </LinearLayout>
    <LinearLayout style="?android:attr/buttonBarStyle" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/snooze30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reminder_snooze_30"/>
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/snooze60" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reminder_snooze_60"/>
    </LinearLayout>
</LinearLayout>
